<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  PTR Foundation checkstyle profile.

  Intentionally narrow: spotless owns formatting, so we only check the
  rules that catch architectural mistakes the formatter cannot:
    - line length cap (matches spotless 100 → we allow 120 for fluent NMS)
    - no star imports (kills the "import *" reflex)
    - mandatory Javadoc on public API
    - no System.out / printStackTrace
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Catch noisy logging anti-patterns. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.out\.println|System\.err\.println|printStackTrace\(\)"/>
            <property name="message" value="Use the plugin SLF4J/Bukkit logger, not System.out / printStackTrace."/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- Forbid Bukkit.getScheduler() — use SchedulerService on Folia. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="Bukkit\.getScheduler\(\)"/>
            <property name="message" value="Bukkit.getScheduler() is not Folia-safe. Use fr.smp.ptr.foundation.platform.SchedulerService."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
