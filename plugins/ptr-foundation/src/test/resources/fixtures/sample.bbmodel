{
  "meta": { "format_version": "5.0", "model_format": "free" },
  "name": "Sample",
  "geometry_name": "ptr:sample",
  "resolution": { "width": 64, "height": 64 },
  "elements": [],
  "outliner": [
    {
      "name": "body",
      "uuid": "bone-body",
      "origin": [0, 8, 0],
      "rotation": [0, 0, 0],
      "children": [
        {
          "name": "head",
          "uuid": "bone-head",
          "origin": [0, 16, 0],
          "rotation": [0, 0, 0],
          "children": []
        }
      ]
    },
    {
      "name": "tail",
      "uuid": "bone-tail",
      "origin": [0, 4, -8],
      "rotation": [0, 0, 0],
      "children": []
    }
  ],
  "animations": [
    {
      "name": "idle",
      "uuid": "anim-idle",
      "loop": "loop",
      "length": 2.0,
      "animators": {
        "bone-head": {
          "name": "head",
          "type": "bone",
          "keyframes": [
            {
              "channel": "rotation",
              "time": 0.0,
              "interpolation": "linear",
              "data_points": [{ "x": 0, "y": 0, "z": 0 }]
            },
            {
              "channel": "rotation",
              "time": 1.0,
              "interpolation": "linear",
              "data_points": [{ "x": 15, "y": 0, "z": 0 }]
            },
            {
              "channel": "rotation",
              "time": 2.0,
              "interpolation": "linear",
              "data_points": [{ "x": 0, "y": 0, "z": 0 }]
            }
          ]
        }
      }
    },
    {
      "name": "attack",
      "uuid": "anim-attack",
      "loop": "once",
      "length": 0.5,
      "animators": {
        "bone-head": {
          "name": "head",
          "type": "bone",
          "keyframes": [
            {
              "channel": "position",
              "time": 0.0,
              "interpolation": "linear",
              "data_points": [{ "x": 0, "y": 0, "z": 0 }]
            },
            {
              "channel": "position",
              "time": 0.25,
              "interpolation": "linear",
              "data_points": [{ "x": 0, "y": 0, "z": 4 }]
            },
            {
              "channel": "position",
              "time": 0.5,
              "interpolation": "linear",
              "data_points": [{ "x": 0, "y": 0, "z": 0 }]
            }
          ]
        }
      }
    }
  ]
